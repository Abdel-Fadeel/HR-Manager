{
  "name": "hr-manager",
  "version": "1.0.0",
  "description": "HR management system for employees, vacations, documents and expiry reports",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "setup-project": "npm i && cd client && npm i",
    "setup-production-app": "npm i && cd client && npm i && npm run build",
    "client": "cd client && npm run dev",
    "server": "nodemon server.js",
    "dev": "concurrently \"npm run client\" \"npm run server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdel-Fadeel/HR-Manager.git"
  },
  "keywords": [],
  "author": "Abdel-Fadeel Hamdy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Abdel-Fadeel/HR-Manager/issues"
  },
  "homepage": "https://github.com/Abdel-Fadeel/HR-Manager#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.37.3",
    "cookie-parser": "^1.4.6",
    "datauri": "^4.1.0",
    "dayjs": "^1.11.9",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.8.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^2.0.22"
  }
}
